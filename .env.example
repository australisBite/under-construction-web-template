# ============================================================================
# DATABASE CONFIGURATION — Supabase (PostgreSQL + Supavisor)
# ============================================================================
# 1. DATABASE_URL (Modo Transacción - Recomendado para la Aplicación/Vercel)
#    - Dashboard: Settings > Database > Connection Pooler
#    - Asegúrate de activar el "Pooler" y seleccionar "Mode: Transaction"
#    - Copia la URL que usa el PUERTO 6543 (o el indicado por el pooler)
#    - Reemplaza [YOUR-PASSWORD] por tu contraseña real
DATABASE_URL="postgresql://postgres.[PROJECT-ID]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL (Conexión Directa - Obligatorio para Migraciones con Drizzle)
#    - Dashboard: Settings > Database > Connection String
#    - Selecciona "Node.js" o "Direct Connection"
#    - Usa el PUERTO 5432 (conexión directa a la base de datos)
#    - Se usa para: pnpm db:push y pnpm db:migrate
DIRECT_URL="postgresql://postgres.wtpxwmqfkbhxlqchobih:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:6543/postgres"

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# URL raíz de la aplicación para CORS y rutas de autenticación
# Desarrollo local: http://localhost:5173
# Producción: https://tucopiloto.com (sin barra final)
ORIGIN="http://localhost:5173"

# ============================================================================
# AUTHENTICATION — Better Auth
# ============================================================================
# Secreto para firmar y verificar tokens JWT. Generar con >= 32 caracteres.
# Comando rápido: openssl rand -base64 32
BETTER_AUTH_SECRET="tu_secreto_aleatorio_minimo_32_caracteres"

# GitHub OAuth (Opcional)
# Callback URL: https://tu-dominio.com/api/auth/callback/github
GITHUB_CLIENT_ID="tu_github_client_id"
GITHUB_CLIENT_SECRET="tu_github_client_secret"

# ============================================================================
# SUPABASE KEYS (Para uso con el cliente de Supabase si es necesario)
# ============================================================================
# Dashboard: Settings > API
PUBLIC_SUPABASE_URL="https://[PROJECT-ID].supabase.co"
PUBLIC_SUPABASE_ANON_KEY="tu_anon_key_publica"
SUPABASE_SERVICE_ROLE_KEY="tu_service_role_key_privada_SOLO_SERVIDOR"

# ============================================================================
# NOTAS DE SEGURIDAD 2026
# ============================================================================
# - DATABASE_URL en Vercel debe usar el POOLER para evitar agotar conexiones.
# - DIRECT_URL solo se usa localmente para sincronizar el esquema (Drizzle).
# - RLS (Row Level Security) debe estar ENABLED en todas las tablas públicas.
# - NUNCA subas el archivo .env real a GitHub.
